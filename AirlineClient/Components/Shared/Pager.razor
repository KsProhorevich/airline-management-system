<div class="pager">
    <button type="button" disabled="@(Page <= 1)" @onclick="Previous">Назад</button>
    <span>Страница @Page из @Math.Max(TotalPages, 1)</span>
    <button type="button" disabled="@(Page >= TotalPages)" @onclick="Next">Вперёд</button>
</div>

@code {
    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    private Task Previous() => PageChanged.InvokeAsync(Page - 1);

    private Task Next() => PageChanged.InvokeAsync(Page + 1);
}
